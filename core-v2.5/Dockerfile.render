FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    ARTEMIDE_CONFIG=/models/config.json \
    ARTEMIDE_CHECKPOINT=/models/latest.pt \
    ARTEMIDE_KEY_DB=/tmp/artemide_api_keys.sqlite3 \
    ARTEMIDE_REQUIRE_API_KEY=1

WORKDIR /app
COPY . /app

RUN python -m pip install --upgrade pip \
 && python -m pip install --index-url https://download.pytorch.org/whl/cpu "torch>=2.1" \
 && python -m pip install ".[api]" \
 && mkdir -p /models \
 && cp configs/small.json /models/config.json \
 && artemide init --config /models/config.json --output /models/latest.pt --seed 42

EXPOSE 10000
CMD ["sh", "-c", "exec artemide serve --host 0.0.0.0 --port ${PORT:-10000}"]
